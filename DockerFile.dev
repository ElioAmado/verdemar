# ------------------------
# Imagen base
# ------------------------
FROM node:22-alpine

# Instalar bash y utilidades (útiles para desarrollo y VSCode)
RUN apk add --no-cache bash curl git openssh

# Configurar Git con ARG para no dejar datos en la imagen final
ARG GIT_USER
ARG GIT_EMAIL
RUN git config --global user.name "$GIT_USER" \
    && git config --global user.email "$GIT_EMAIL"

# Crear carpeta de trabajo
WORKDIR /app

# Copiar archivos de dependencias primero (cache-friendly)
COPY package.json pnpm-lock.yaml* ./

# Instalar pnpm y dependencias
# ⚡ Cambié a "pnpm install" simple para evitar errores de lock file en dev
RUN npm install -g pnpm && pnpm install

# Copiar el resto del código
COPY . .

# Exponer el puerto de desarrollo
EXPOSE 3000

# Cargar variables de entorno desde un .env si existe
ENV NODE_ENV=development
ENV DOTENV_CONFIG_PATH=.env

# Evita que el contenedor se apague si pnpm run dev falla
CMD ["sh", "-c", "pnpm run dev || (echo '❌ Falló pnpm run dev, pero el contenedor sigue vivo'; tail -f /dev/null)"]
